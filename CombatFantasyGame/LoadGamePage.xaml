<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="CombatFantasyGame.LoadGamePage"
             Title="Cargar partida">

    <VerticalStackLayout Padding="20" Spacing="15">
        <Label x:Name="HeaderLabel"
               Style="{StaticResource Headline}"
               Text="Cargar partida" />

        <CollectionView x:Name="SavesCollectionView"
                        SelectionMode="Single"
                        SelectionChanged="OnSelectionChanged"
                        HeightRequest="400">
            <CollectionView.ItemTemplate>
                <DataTemplate>
                    <Frame Padding="15" Margin="0,5"
                           BorderColor="#444"
                           CornerRadius="10">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="{Binding Title}"
                                   FontAttributes="Bold"
                                   FontSize="18" />
                            <Label Text="{Binding Players}" />
                            <Label Text="{Binding TurnInfo}"
                                   FontSize="13" />
                            <Label Text="{Binding CreatedAt}"
                                   FontSize="12"
                                   TextColor="Gray" />
                        </VerticalStackLayout>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <Label x:Name="EmptyLabel"
               Text="No hay partidas guardadas."
               IsVisible="False"
               HorizontalTextAlignment="Center"
               Margin="0,10,0,0" />

        <Button x:Name="CloseButton"
                Text="Volver"
                Clicked="OnCloseClicked" />
    </VerticalStackLayout>

</ContentPage>
